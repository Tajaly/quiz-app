# Copy to `.env` (or export the variables) to customise local runs. Everything is optional:
# without any settings the server uses account-free guest hosting and in-memory storage.

# PORT=3000
# LOG_LEVEL=info

# ---- Host access ---------------------------------------------------------------
# `guest` = no login; a private browser key protects each host's quizzes and races (also in production).
# AUTH_MODE=guest
# `dev` = name-only sign-in for local development (refused when NODE_ENV=production).
# AUTH_MODE=dev
# Opt into Microsoft Entra ID sign-in (values from `azd env get-values` after Entra provisioning):
# AUTH_MODE=entra
# ENTRA_TENANT_ID=<tenant id>
# ENTRA_CLIENT_ID=<app registration client id>
# ENTRA_API_SCOPE_NAME=Quiz.Host

# ---- Storage -------------------------------------------------------------------
# Local Cosmos DB emulator (`docker compose up -d`); the key is the emulator's well-known public key.
# COSMOS_ENDPOINT=http://localhost:8081
# COSMOS_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==
# COSMOS_CREATE_IF_NOT_EXISTS=true
# Azure Cosmos DB with your Entra identity (no key; requires the data contributor role from Bicep):
# COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
# COSMOS_DATABASE=powerquiz
# RESULT_TTL_DAYS=90
